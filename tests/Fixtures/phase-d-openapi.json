    "components": {
        "securitySchemes": {
            "spaSession": {
                "type": "apiKey",
                "in": "cookie",
                "name": "expedflow-session"
            },
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "locale": {
                        "type": "string",
                        "enum": [
                            "es",
                            "ca",
                            "en"
                        ]
                    },
                    "active": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "locale",
                    "active"
                ],
                "additionalProperties": false
            },
            "Identity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "locale": {
                        "type": "string",
                        "enum": [
                            "es",
                            "ca",
                            "en"
                        ]
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "locale",
                    "active",
                    "permissions"
                ],
                "additionalProperties": false
            },
            "Error": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "message",
                    "code"
                ],
                "additionalProperties": false
            },
            "Action": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
