{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js frontend-tests e2e eslint.config.js vite.config.js vitest.config.ts playwright.config.ts",
        "format:check": "prettier --check resources/js/testing frontend-tests e2e eslint.config.js vite.config.js vitest.config.ts playwright.config.ts tsconfig.json",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test --grep-invert @a11y",
        "test:a11y": "playwright test --grep @a11y"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.1",
        "@eslint/js": "^10.0.1",
        "@fontsource/instrument-sans": "^5.3.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.19.4",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/test-utils": "^2.6.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.0.0",
        "vitest": "^5.1.2",
        "vue": "^3.5.46",
        "vue-eslint-parser": "^10.4.2",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
